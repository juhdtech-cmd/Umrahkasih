rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    match /musawwiqProfiles/{uid} {
      allow create: if isOwner(uid);
      allow read: if isOwner(uid) || isStaff();
      allow update: if isOwner(uid) || isStaff();
      allow delete: if false;
    }

    match /referralPublic/{code} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.musawwiqUid == request.auth.uid;
      allow update, delete: if isStaff();
    }

    match /leads/{leadId} {
      allow read: if isStaff() || (signedIn() && resource.data.musawwiqUid == request.auth.uid);
      allow create: if false; // Diaktifkan apabila customer enquiry form/secure endpoint siap.
      allow update: if isStaff();
      allow delete: if false;
    }

    match /commissions/{commissionId} {
      allow read: if isStaff() || (signedIn() && resource.data.musawwiqUid == request.auth.uid);
      allow write: if isStaff();
    }

    match /marketingMaterials/{materialId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /staff/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
