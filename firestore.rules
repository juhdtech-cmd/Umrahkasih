rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isStaff() { return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function validReferral(code) {
      return exists(/databases/$(database)/documents/referralPublic/$(code)) &&
        get(/databases/$(database)/documents/referralPublic/$(code)).data.active == true;
    }

    match /musawwiqProfiles/{uid} {
      allow create: if isOwner(uid);
      allow read: if isOwner(uid) || isStaff();
      allow update: if isOwner(uid) || isStaff();
      allow delete: if false;
    }

    match /referralPublic/{code} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.musawwiqUid == request.auth.uid;
      allow update, delete: if isStaff();
    }

    match /leads/{leadId} {
      allow read: if isStaff() || (signedIn() && resource.data.musawwiqUid == request.auth.uid);
      allow create: if request.auth == null
        && request.resource.data.keys().hasOnly([
          'customerName','customerPhone','packageId','packageName','packageSeason','departure','room','quotedPrice',
          'referralCode','musawwiqUid','status','potentialCommission','createdAt'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerName.size() <= 80
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() >= 7
        && request.resource.data.customerPhone.size() <= 24
        && request.resource.data.referralCode is string
        && request.resource.data.referralCode.size() >= 5
        && request.resource.data.referralCode.size() <= 40
        && request.resource.data.status == 'Pertanyaan Baru'
        && request.resource.data.potentialCommission == 0
        && request.resource.data.quotedPrice >= 0
        && validReferral(request.resource.data.referralCode)
        && request.resource.data.musawwiqUid == get(/databases/$(database)/documents/referralPublic/$(request.resource.data.referralCode)).data.musawwiqUid;
      allow update: if isStaff();
      allow delete: if false;
    }

    match /commissions/{commissionId} {
      allow read: if isStaff() || (signedIn() && resource.data.musawwiqUid == request.auth.uid);
      allow write: if isStaff();
    }

    match /marketingMaterials/{materialId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /staff/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
